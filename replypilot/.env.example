# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# --- App ----------------------------------------------------------------------
# Public URL of the app, no trailing slash. Used in auth emails and Stripe
# redirects. Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...). The legacy "service_role" key also works.
# Server-only: it bypasses Row Level Security. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Claude API (console.anthropic.com → API Keys) -----------------------------
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional: override the model (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Stripe (dashboard.stripe.com → Developers → API keys) ---------------------
# Use test-mode keys (sk_test_...) until you're ready to take real payments.
STRIPE_SECRET_KEY=sk_test_xxx
# Price ID of the $39/month recurring price for "ReplyPilot Pro".
STRIPE_PRO_PRICE_ID=price_xxx
# Signing secret of the webhook endpoint (or from `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Landing-page demo ---------------------------------------------------------
# Random secret used to hash visitor IPs. Generate with: openssl rand -hex 32
DEMO_IP_SALT=change-me
# Cost guard: max demo generations across all visitors per 24 hours.
DEMO_DAILY_LIMIT=200
